# Copy to .env and fill in for local development.
# See README.md "Environment requirements" for details on each service.

# PostgreSQL connection string (see docker-compose.yml for local defaults,
# or point at a hosted Postgres — e.g. Supabase — if you don't have Docker).
DATABASE_URL="postgresql://cohortcove:cohortcove@localhost:5432/cohortcove?schema=public"
# Direct (non-pooled) connection, used for migrations. Same as DATABASE_URL
# for a plain local Postgres; set separately when DATABASE_URL goes through
# a connection pooler (e.g. Supabase's pgbouncer endpoint).
DIRECT_URL="postgresql://cohortcove:cohortcove@localhost:5432/cohortcove?schema=public"

# Public base URL used to build links in outgoing emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis connection string, used for local BullMQ-backed job scheduling
# (recurrence horizon extension, reminders) when running docker-compose.
# Not required in production — see README "Jobs on serverless".
REDIS_URL="redis://localhost:6379"

# Symmetric secret used to sign session, email-verification, and step-up
# (reauthentication) tokens. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-32-byte-secret"

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# to /api/cron/* routes. Required in production; generate the same way as
# AUTH_SECRET.
CRON_SECRET=""

# Email adapter. EMAIL_ADAPTER=console (local dev) writes to .local-emails/.
# EMAIL_ADAPTER=db writes to the EmailOutbox table, viewable at
# /dev/outbox — used on the live demo deploy since local disk writes don't
# persist on serverless. EMAIL_ADAPTER=smtp is an unimplemented integration
# point (throws on use) for a real transport.
EMAIL_ADAPTER="console"
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="notifications@cohortcove.demo"

# Object storage for organization/event images. STORAGE_ADAPTER=local
# (default) writes to .local-uploads/. STORAGE_ADAPTER=supabase uses
# Supabase Storage via its REST API — set SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY, and SUPABASE_STORAGE_BUCKET.
STORAGE_ADAPTER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="cohortcove-uploads"

# Comma-separated list of allowed institutional email domains for the
# single demo institution seeded in MVP.
DEMO_INSTITUTION_ALLOWED_DOMAINS="students.midlandstate.demo,staff.midlandstate.demo"
