# Copy to .env for local development. Every variable is documented in
# README.md → "Configuration".

# --- Database (PostgreSQL 14+) -----------------------------------------------
# Local: `docker compose up -d postgres`. Hosted (e.g. Supabase): use the
# pooled connection string here (add ?pgbouncer=true&connection_limit=1 on
# serverless) and the direct/session connection in DIRECT_URL for migrations.
DATABASE_URL="postgresql://cohortcove:cohortcove@localhost:5432/cohortcove?schema=public"
DIRECT_URL="postgresql://cohortcove:cohortcove@localhost:5432/cohortcove?schema=public"

# --- App -----------------------------------------------------------------------
# Public base URL used in emails and calendar feeds. On Vercel, falls back to
# the deployment URL when unset — set it to your custom domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Signs sessions and reauthentication links. At least 32 random characters:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-32-byte-secret"

# Bearer secret Vercel Cron sends to /api/cron/*. Generate like AUTH_SECRET.
CRON_SECRET=""

# Shows one-click demo personas on /login, enables the nightly demo reset,
# and — when no email provider is configured — lets *sandbox* campuses show
# sign-in links on screen. Never enable with real student data.
DEMO_MODE="false"

# --- Email -----------------------------------------------------------------------
# resend  : real delivery via Resend (set RESEND_API_KEY + EMAIL_FROM on a verified domain)
# db      : record to the EmailOutbox table only (nothing is sent)
# console : write to .local-emails/ (local dev default)
# Unset → resend if RESEND_API_KEY is present, else console (dev) / db (production).
EMAIL_ADAPTER="console"
RESEND_API_KEY=""
EMAIL_FROM="CohortCove <notifications@yourdomain.com>"
SUPPORT_EMAIL="hello@yourdomain.com"

# --- File storage (organization logos, event images) -----------------------------
# local    : .local-uploads/ (dev only — serverless disks don't persist)
# supabase : Supabase Storage bucket via REST (create a *private* bucket first)
STORAGE_ADAPTER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="cohortcove-uploads"
