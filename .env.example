# Copy to .env and fill in for local development.
# See README.md "Environment requirements" for details on each service.

# PostgreSQL connection string (see docker-compose.yml for local defaults)
DATABASE_URL="postgresql://cohortcove:cohortcove@localhost:5432/cohortcove?schema=public"

# Redis connection string, used for verification emails, reminders,
# waitlist promotion, recurrence generation, and moderation queue jobs.
REDIS_URL="redis://localhost:6379"

# Symmetric secret used to sign session and email-verification tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-32-byte-secret"

# Local dev email adapter. When EMAIL_ADAPTER=console, verification and
# notification emails are logged to stdout and written to .local-emails/
# instead of being sent. Set EMAIL_ADAPTER=smtp and fill in the SMTP_*
# vars to test against a real sandbox inbox (e.g. Mailpit, Mailhog).
EMAIL_ADAPTER="console"
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="notifications@cohortcove.demo"

# Object storage for organization/event images. Local dev defaults to
# on-disk storage under .local-uploads/; set STORAGE_ADAPTER=s3 and the
# S3_* vars for a real bucket before production use.
STORAGE_ADAPTER="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Comma-separated list of allowed institutional email domains for the
# single demo institution seeded in MVP.
DEMO_INSTITUTION_ALLOWED_DOMAINS="students.midlandstate.demo,staff.midlandstate.demo"
