{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/recurrence",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/demo-reset",
      "schedule": "0 9 * * *"
    }
  ]
}
